{
  "uid": "fixbugs-demo",
  "title": "FixBugs demo: API 5xx by route",
  "tags": [
    "fixbugs-demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "5xx by route (PolarEndpoint5xx expression)",
      "description": "Same expression as the PolarEndpoint5xx alert rule (dev/docker/demo/alert-rules.yml).",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint, method) (increase(polar_http_request_total{status_code=~\"5..\"}[2m])) > 0\nor\nsum by (endpoint, method) (\n  polar_http_request_total{status_code=~\"5..\"}\n  unless polar_http_request_total{status_code=~\"5..\"} offset 2m\n) > 0",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests by route and status",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, endpoint, status_code) (rate(polar_http_request_total[1m]))",
          "legendFormat": "{{method}} {{endpoint}} {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
